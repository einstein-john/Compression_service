{
  "name": "compression-service",
  "version": "1.0.0",
  "description": "File Compression Service CLI and library for images, PDFs, videos, and Office documents.",
  "main": "dist/index.js",
  "scripts": {
    "cli": "ts-node src/index.ts",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "ts-node src/server.ts",
    "dev:web": "npm run dev --prefix frontend",
    "start": "ts-node src/server.ts",
    "build": "tsc",
    "build:web": "npm run build --prefix frontend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.21.0",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.2",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.0.0",
    "concurrently": "^9.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
